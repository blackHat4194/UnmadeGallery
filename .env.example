# GEMINI_API_KEY: Required if Gemini AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Hosting base URL.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB Local or Atlas connection string (leave blank to use JSON file fallback in backend/data/).
MONGODB_URI="mongodb://127.0.0.1:27017/unmade_gallery"

# JWT_SECRET: Secret key used by backend/routes/galleryRoutes.js for customer session JWT tokens.
JWT_SECRET="change_this_to_a_strong_random_secret"

# FRONTEND_URL: Allowed CORS origin when running backend and frontend separately.
FRONTEND_URL="http://localhost:5173"

# VITE_API_URL: Optional frontend override when API is hosted on a separate domain (leave empty for local proxy / unified mode).
VITE_API_URL=""
