# Backend Server Port (default 5000 when running standalone)
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/unmade_gallery

# JWT Signing Secret (REQUIRED in production - minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_characters_of_cryptographic_randomness

# Comma-separated list of allowed CORS origins (never use * in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# CLI Admin Bootstrap Variables (used only when running: node backend/scripts/createAdmin.js)
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
