# Backend Server Port (default 5000 when running standalone)
PORT=5000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
# When omitted, the backend automatically uses JSON persistence inside backend/data/
MONGODB_URI=mongodb://127.0.0.1:27017/unmade_gallery

# JWT Signing Secret for Customer & Admin Authentication
JWT_SECRET=unmade_gallery_dev_jwt_secret_change_in_production

# Allowed Frontend Origin for CORS (Vite standalone dev runs on 5173)
FRONTEND_URL=http://localhost:5173
